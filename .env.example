# Rename this file to .env and fill in your own values

# MongoDB Atlas connection string
# Get this from Atlas > Database > Connect > Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# Port the API server runs on
PORT=5000

# Secret used to sign admin JWT tokens - use a long random string
JWT_SECRET=change_this_to_a_long_random_secret

# Admin login credentials (used only by the one-time seed script)
ADMIN_EMAIL=shyamsharma729785@gmail.com
ADMIN_PASSWORD=change_this_password

# Comma separated list of origins allowed to call the API
CLIENT_URL=http://localhost:5173
